      "version": 1,
      "number": 11,
      "title": "Lekcija 11 — lang, charset i viewport",
      "level": "Početnik",
      "summary": "Nauči da navedeš jezik stranice, kodiranje i prilagođavanje mobilnom ekranu.",
      "language": "html",
      "steps": [
        {
          "label": "Jezik dokumenta",
          "description": "Na <html> dodaj atribut lang=\"sr\" da označiš srpski jezik."
        },
        {
          "label": "Srpska slova",
          "description": "Unutar <head> dodaj <meta charset=\"UTF-8\"> radi pravilnog prikaza č, ć, š, ž, đ."
        },
        {
          "label": "Mobilni prikaz",
          "description": "Unutar <head> dodaj <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">."
        },
        {
          "label": "Naslov",
          "description": "Postavi <title>Moja HTML lekcija 11</title> u head."
        },
        {
          "label": "Sadržaj",
          "description": "U body napiši <h1>Učim HTML</h1> i <p>Čaša, ćevap, škola, žaba, đak.</p>."
        }
      ],
