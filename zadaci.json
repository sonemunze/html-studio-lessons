    {
      "id": "html-12-komentari",
      "version": 1,
      "number": 12,
      "title": "Lekcija 12 — HTML komentari",
      "level": "Početnik",
      "summary": "Nauči sintaksu <!-- komentar -->, dodaj dve jasne beleške i privremeno sakrij jedan pasus. HTML komentari nisu mesto za tajne podatke.",
      "language": "html",
      "steps": [
        {
          "label": "Pravilo 1 — početak i kraj",
          "description": "HTML komentar počinje sa <!-- i završava se sa -->. Browser ga ne prikazuje posetiocima, ali je vidljiv u izvornom HTML kodu."
        },
        {
          "label": "Prvi komentar",
          "description": "Odmah pre <h1> napiši tačno: <!-- Glavni naslov -->"
        },
        {
          "label": "Drugi komentar",
          "description": "Odmah pre <ul> napiši tačno: <!-- SEO usluge -->"
        },
        {
          "label": "Sakrij pasus",
          "description": "Odmah posle </ul> napiši tačno: <!-- <p>Skrivena poruka</p> -->. Taj pasus ne sme biti vidljiv u browseru."
        },
        {
          "label": "Sačuvaj sadržaj",
          "description": "Naslov mora biti Moja SEO agencija, vidljivi pasus Učim HTML komentare., a lista mora imati stavke SEO Audit i Link Building."
        },
        {
          "label": "Bez tajni",
          "description": "Ne čuvaj API ključeve, lozinke ni druge tajne u HTML komentarima."
        }
      ],
      "previewTable": [],
